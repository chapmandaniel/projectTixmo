# Local and deploy configuration. Copy to .env and fill values there.
# .env is gitignored. Do not commit tokens, and do not point this at production
# from the local demo. The local demo script writes .env for 127.0.0.1 only.

# API origin with no path. https in any deployed environment. http is accepted
# only for localhost, 127.0.0.1, and ::1.
TIXMO_API_URL=http://127.0.0.1:3000

# Bearer token minted for this environment. Prefix gwc_. Never log it.
TIXMO_CHECKER_TOKEN=

# JSON watchlist of organizations to protect. The checker token cannot read
# accounts from the API, so targets come from this file.
TIXMO_WATCHLIST_PATH=.local/watchlist.json

# Shown in the public-page User-Agent. Use a page you control.
CHECKER_CONTACT_URL=http://127.0.0.1:5173/brand-protection

# Official API credentials. Omit a pair to skip that source. Do not commit them.
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Milliseconds between Facebook and Instagram public page reads.
# Default when unset: 15000. Fixtures mode uses 0 unless this is set.
PUBLIC_PAGE_INTERVAL_MS=

# crt.sh cache file. Lookalike reads use this cache and back off on 429.
CRTSH_CACHE_PATH=.cache/crtsh.json

# Optional official lookalike search API. Must be an API you are allowed to call.
# Search-engine hosts are refused. Never put a search-engine URL here.
LOOKALIKE_SEARCH_API_URL=
LOOKALIKE_SEARCH_API_KEY=

# Local run report. Counts and status only.
BRAND_CHECKER_REPORT=.local/last-run.json
