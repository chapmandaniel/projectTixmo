VITE_API_URL=/api/v1

# Labs branch banner. Railway must set this as a build variable so Vite inlines it.
# The image entrypoint also copies it into runtime-config.js at container start.
# Unset shows no banner. /health does not return a branch name.
# VITE_APP_LABS_BRANCH=cursor/vendor-import-showpass-5658
# Any non-empty value other than production blocks search indexing. Unset stays indexable.
# VITE_APP_ENV=

# Checkout and policy pages. Empty hides the link. Paid checkout needs the publishable key.
# VITE_PRIVACY_POLICY_URL=
# VITE_TERMS_URL=
# VITE_REFUND_POLICY_URL=
# VITE_ORGANIZER_TERMS_URL=
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_PAYMENT_CURRENCY=cad
# Optional analytics ids. Unset leaves the analytics helpers empty.
# VITE_GOOGLE_ANALYTICS_PROPERTY_ID=
# VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Buyer policy pages read these at container start (see docker-entrypoint.d/40-runtime-config.sh).
# Each defaults to empty. An empty value hides the line or sentence that would show it.
# Receipts do not copy this string as the organizer. They default to "Tixmo Ltd."
# and name the event's organization. Set a plain platform legal name only.
# TIXMO_SELLER_NAME="Tixmo Ltd."
# SUPPORT_EMAIL=info@tixmo.co
# TIXMO_HST_NUMBER=
# TIXMO_MAILING_ADDRESS=
# VENUE_POLICY_URL=
