VITE_API_URL=/api/v1

# Buyer policy pages read these at container start (see docker-entrypoint.d/40-runtime-config.sh).
# Each defaults to empty. An empty value hides the line or sentence that would show it.
# Receipts do not copy this string as the organizer. They default to "Tixmo Ltd."
# and name the event's organization. Set a plain platform legal name only.
# TIXMO_SELLER_NAME="Tixmo Ltd."
# SUPPORT_EMAIL=info@tixmo.co
# TIXMO_HST_NUMBER=
# TIXMO_MAILING_ADDRESS=
# VENUE_POLICY_URL=
