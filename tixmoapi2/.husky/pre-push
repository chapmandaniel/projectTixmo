#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Receipt suites refuse leftover runtime/task6NN-*.json from a previous
# verify:api in this clone (task608, task609, task612, task615, task616, …).
# Scoped glob only; rm -f is safe if none exist.
rm -f runtime/task6[0-9][0-9]-*.json

# The API suite runs in a single Jest process (--runInBand, required by the
# shared disposable database). Local full-suite runs need an 8192 MiB V8
# ceiling (T144); CI leaves the runner default (tixmoapi2/scripts/run-jest.cjs).
# Raise only that ceiling so the hook does not OOM. Same commands and tests;
# a failure still blocks the push. An existing --max-old-space-size of 8192
# or higher in NODE_OPTIONS wins; npm test also bumps a smaller cap.
case " ${NODE_OPTIONS:-} " in
  *" --max-old-space-size="*) ;;
  *) NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=8192"
     export NODE_OPTIONS ;;
esac

# Run tests through the runner that owns and validates disposable databases.
npm --prefix tixmoapi2 run typecheck || exit 1
npm run verify:api || exit 1
