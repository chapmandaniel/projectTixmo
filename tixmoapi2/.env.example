# Application
NODE_ENV=development
SERVICE_NAME=tixmo-api
PORT=3000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://tixmo:tixmo_dev_password@localhost:5432/tixmoapi?schema=public
# Destructive fixture commands require both an explicit matching URL and opt-in.
# Set these in the command environment only after confirming the local database.
# TIXMO_DEV_DATABASE_URL=postgresql://tixmo:tixmo_dev_password@localhost:5432/tixmoapi?schema=public
# TIXMO_ALLOW_DEV_DATA=true
# Setup --migrate instead requires TIXMO_ALLOW_LOCAL_MIGRATIONS=true.
# Approvals fixtures also require TIXMO_DEV_SEED_PASSWORD (at least 12 characters).

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMENT_CURRENCY=cad

# Email (Postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
FROM_EMAIL=noreply@tixmo.com
FROM_NAME=Tixmo

# Inclusive HST rate as a decimal from 0 to 1. Defaults to 0.15 (15%).
# Receipt HST = total * rate / (1 + rate), rounded to the cent once per order.
# This does not change the amount charged or the stored taxAmount.
# TIXMO_HST_RATE=0.15

# GST/HST registration number printed on buyer receipts (9 digits, RT, 4 digits).
# Set this on the API service. A missing, placeholder, or invalid value logs one
# warning at startup and the HST number line is left off the receipt. It does not
# stop production from booting.
# TIXMO_HST_NUMBER=123456789RT0001

# Email (SMTP, optional alternative to Postmark)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@tixmo.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# S3 / Object Storage (Railway S3 compatible)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=tixmo-uploads
S3_REGION=us-east-1
# Match the bucket credential URL style: path or virtual.
S3_URL_STYLE=path

# Standard AWS Variables (Fallback)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=tixmo-uploads

# Elasticsearch
# ELASTICSEARCH_NODE=https://es.example.com
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_ALERT_ROUTE=admin@tixmo.co
SENTRY_TRACES_SAMPLE_RATE=0.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_READ_MAX=600
RATE_LIMIT_WRITE_MAX=240
# Legacy fallback used by older deployments:
# RATE_LIMIT_MAX=300
# Authenticated scan, offline sync, and validate. One bucket per scanner API key,
# not per venue IP. 2,000 per 15 minutes covers 1,000 door scans plus retries.
SCANNER_RATE_LIMIT_WINDOW_MS=900000
SCANNER_RATE_LIMIT_MAX=2000
# Rejected scanner keys only. A valid key does not consume this bucket.
SCANNER_AUTH_FAILURE_WINDOW_MS=60000
SCANNER_AUTH_FAILURE_MAX=30
# Checkout writes (order hold/create, cancel, confirm, payment intent). Per user,
# or per guest session. Not the shared 240 write bucket.
# 40 per 10 minutes covers a hold, payment intent, cancel, and retries.
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000
CHECKOUT_RATE_LIMIT_MAX=40
# Abuse ceiling for one public address. 200 buyers at 10 writes is 2,000;
# 4,000 leaves headroom for that NAT during the first 10 minutes.
CHECKOUT_IP_RATE_LIMIT_WINDOW_MS=600000
CHECKOUT_IP_RATE_LIMIT_MAX=4000
# Login and other auth routes. Per IP, plus the per-account bucket below.
# Production admits 20 per minute from one address. Tests use 100 unless the
# strict header forces 5. Development uses 100 when this is unset.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
# One email, reset token, or refresh token, across every IP.
# Tests use 1000 when this is unset, or 3 when they send the low account header.
AUTH_ACCOUNT_RATE_LIMIT_WINDOW_MS=60000
AUTH_ACCOUNT_RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Session
SESSION_SECRET=

# Feature Flags
ENABLE_RESALE_MARKET=false
ENABLE_APPROVAL_REMINDERS=false
# Enable reminders only after the mail provider is accepted and all older API workers are stopped.
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=true

# Cart Settings
CART_EXPIRY_MINUTES=10
SEAT_LOCK_DURATION_SECONDS=600
